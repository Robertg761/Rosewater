<?xml version="1.0" encoding="utf-8"?>
<!--
  Three stat columns are spelled out rather than <include>d: RemoteViews cannot
  address duplicated ids, so each column needs its own.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/rw_bg_fill"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/rw_card_fill" />

  <ImageView
    android:id="@+id/rw_bg_stroke"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/rw_card_stroke" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/rw_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/rw_nunito_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.09"
        android:maxLines="1"
        android:text="MY HAIR"
        android:textColor="#8A7076"
        android:textSize="10sp" />

      <LinearLayout
        android:id="@+id/rw_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/rw_streak_icon"
          android:layout_width="13dp"
          android:layout_height="13dp"
          android:contentDescription="@null"
          android:src="@drawable/rw_ic_fire" />

        <TextView
          android:id="@+id/rw_streak_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="3dp"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="12"
          android:textColor="#E5A020"
          android:textSize="11sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="6dp"
      android:layout_weight="1"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <!-- Wash -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/rw_c1_icon"
          android:layout_width="21dp"
          android:layout_height="21dp"
          android:contentDescription="@null"
          android:src="@drawable/rw_ic_shower" />

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:baselineAligned="true"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/rw_c1_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rw_fraunces_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="4"
            android:textColor="#35242A"
            android:textSize="23sp" />

          <TextView
            android:id="@+id/rw_c1_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/rw_nunito_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="days"
            android:textColor="#8A7076"
            android:textSize="10sp" />
        </LinearLayout>

        <TextView
          android:id="@+id/rw_c1_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="Wash"
          android:textColor="#35242A"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/rw_c1_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="Aug 13"
          android:textColor="#B9A3A8"
          android:textSize="10sp" />
      </LinearLayout>

      <!-- Deep condition -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/rw_c2_icon"
          android:layout_width="21dp"
          android:layout_height="21dp"
          android:contentDescription="@null"
          android:src="@drawable/rw_ic_deep" />

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:baselineAligned="true"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/rw_c2_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rw_fraunces_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="11"
            android:textColor="#35242A"
            android:textSize="23sp" />

          <TextView
            android:id="@+id/rw_c2_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/rw_nunito_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="days"
            android:textColor="#8A7076"
            android:textSize="10sp" />
        </LinearLayout>

        <TextView
          android:id="@+id/rw_c2_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="Deep cond."
          android:textColor="#35242A"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/rw_c2_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="Aug 6"
          android:textColor="#B9A3A8"
          android:textSize="10sp" />
      </LinearLayout>

      <!-- Trim -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
          android:id="@+id/rw_c3_icon"
          android:layout_width="21dp"
          android:layout_height="21dp"
          android:contentDescription="@null"
          android:src="@drawable/rw_ic_trim" />

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:baselineAligned="true"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/rw_c3_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rw_fraunces_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="38"
            android:textColor="#35242A"
            android:textSize="23sp" />

          <TextView
            android:id="@+id/rw_c3_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/rw_nunito_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="days"
            android:textColor="#8A7076"
            android:textSize="10sp" />
        </LinearLayout>

        <TextView
          android:id="@+id/rw_c3_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="Trim"
          android:textColor="#35242A"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/rw_c3_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="Jul 10"
          android:textColor="#B9A3A8"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
