<?xml version="1.0" encoding="utf-8"?>
<!--
  Literal colours and sample copy here are what the launcher's picker renders
  for previewLayout; everything is overwritten on the first update.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/rw_bg_fill"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/rw_card_fill" />

  <ImageView
    android:id="@+id/rw_bg_stroke"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/rw_card_stroke" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/rw_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rw_nunito_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.09"
        android:maxLines="1"
        android:text="SINCE LAST WASH"
        android:textColor="#8A7076"
        android:textSize="10sp" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/rw_days"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/rw_fraunces_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="4"
          android:textColor="#C25470"
          android:textSize="30sp" />

        <TextView
          android:id="@+id/rw_unit"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:fontFamily="@font/rw_nunito_bold"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="days"
          android:textColor="#C25470"
          android:textSize="13sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/rw_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/rw_nunito_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Co-wash · Aug 13"
        android:textColor="#8A7076"
        android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="46dp"
      android:layout_height="46dp"
      android:layout_marginStart="10dp">

      <ImageView
        android:id="@+id/rw_icon_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:src="@drawable/rw_circle" />

      <ImageView
        android:id="@+id/rw_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/rw_ic_shower" />
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
